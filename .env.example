PORT=3000
PUBLIC_URL=http://localhost:3000

# Transitional local store. Production business data moves to Supabase.
DATA_FILE=./data/store.json
STORAGE_DIR=./data/uploads
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters

# Supabase — public project URL is safe to source-control; the secret key is not.
SUPABASE_URL=https://rxxmbnlqomtfjekdrblo.supabase.co
AKINAEL_TENANT_NAME=akinael
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Legacy migration compatibility only:
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=

# Autonomous execution worker (Render)
WORKER_INTERVAL_MS=5000
# OPENAI_API_KEY=
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
RESEARCH_MODEL=gpt-5.6-terra
GENERAL_AGENT_MODEL=gpt-5.6-terra

# GitHub service executor used by the Render Worker.
GITHUB_API_URL=https://api.github.com
GITHUB_EXECUTOR_REPO=Yufi-Web-Create/akinael-ai
GITHUB_EXECUTOR_REF=main
GITHUB_AGENT_WORKFLOW=akinael-agent.yml
# GitHub App ID is non-secret and pinned for the production App.
GITHUB_APP_ID=4762113
# GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Optional override only; runtime auto-discovers the installation for GITHUB_EXECUTOR_REPO when omitted.
# GITHUB_APP_INSTALLATION_ID=
# Migration/local fallback only:
# GITHUB_WORKER_TOKEN=

# New-web repository bootstrap. Production uses the dedicated customer organization.
GITHUB_REPO_OWNER=akinael-ai-clients
GITHUB_REPO_OWNER_TYPE=org
GITHUB_CUSTOMER_REPO_PREFIX=client
# Organization bootstrap uses the GitHub App; no personal PAT is required.
# GITHUB_BOOTSTRAP_TOKEN=  # legacy/personal-account fallback only
# Optional: use an existing template instead of the bundled Next.js starter.
# GITHUB_TEMPLATE_REPO=akinael-ai-clients/akinael-web-template

# Central GitHub Actions runner configuration — configured once on GITHUB_EXECUTOR_REPO.
# Actions secret: OPENAI_API_KEY
# Actions secret: AKINAEL_GITHUB_APP_PRIVATE_KEY
# App ID 4762113 and bot user akinael-ai-runtime-yufi[bot] are pinned in the workflow.
# Supabase credentials do NOT belong in GitHub Actions.

# Legacy/general LLM adapter used by existing endpoints during migration.
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=

PAYMENT_PROVIDER=manual-adapter
# STRIPE_SECRET_KEY=
NOTIFICATION_PROVIDER=log
# RESEND_API_KEY=
# MAIL_FROM=
OBJECT_STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
