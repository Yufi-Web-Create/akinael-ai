PORT=3000
PUBLIC_URL=http://localhost:3000

# Transitional local store. Production business data moves to Supabase.
DATA_FILE=./data/store.json
STORAGE_DIR=./data/uploads
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters

# Supabase
SUPABASE_URL=https://your-project.supabase.co
AKINAEL_TENANT_NAME=akinael
# Preferred modern keys. Never expose SUPABASE_SECRET_KEY to browser code.
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Legacy migration compatibility only:
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=

# Autonomous execution worker
WORKER_INTERVAL_MS=5000
# OPENAI_API_KEY=
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
RESEARCH_MODEL=gpt-5.6-terra
GENERAL_AGENT_MODEL=gpt-5.6-terra

# GitHub executor. Prefer a GitHub App in production; GITHUB_WORKER_TOKEN is a migration/local fallback.
GITHUB_API_URL=https://api.github.com
GITHUB_EXECUTOR_REPO=Yufi-Web-Create/akinael-ai
GITHUB_EXECUTOR_REF=main
GITHUB_AGENT_WORKFLOW=akinael-agent.yml
# GITHUB_WORKER_TOKEN=
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# New-web repository bootstrap.
GITHUB_REPO_OWNER=Yufi-Web-Create
GITHUB_REPO_OWNER_TYPE=user
GITHUB_CUSTOMER_REPO_PREFIX=client
# Personal-account repository creation needs a user/fine-grained token with Administration+Contents write.
# Organizations can instead use the GitHub App installation token with Administration+Contents write.
# GITHUB_BOOTSTRAP_TOKEN=
# Optional: when set, use an existing GitHub template repository instead of the bundled Next.js starter.
# GITHUB_TEMPLATE_REPO=Yufi-Web-Create/akinael-web-template

# GitHub Actions secrets/variable configured once on GITHUB_EXECUTOR_REPO (not copied to customer repositories):
# OPENAI_API_KEY
# AKINAEL_GITHUB_APP_ID
# AKINAEL_GITHUB_APP_PRIVATE_KEY
# repository variable AKINAEL_BOT_USER=your-app-name[bot]

# Legacy/general LLM adapter used by existing endpoints during migration.
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=

PAYMENT_PROVIDER=manual-adapter
# STRIPE_SECRET_KEY=
NOTIFICATION_PROVIDER=log
# RESEND_API_KEY=
# MAIL_FROM=
OBJECT_STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
