PORT=3000
PUBLIC_URL=http://localhost:3000

# Transitional local store. Production business data moves to Supabase.
DATA_FILE=./data/store.json
STORAGE_DIR=./data/uploads
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-at-least-12-characters

# Supabase
SUPABASE_URL=https://your-project.supabase.co
# Preferred modern keys. Never expose SUPABASE_SECRET_KEY to browser code.
# SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Legacy migration compatibility only:
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=

LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=
PAYMENT_PROVIDER=manual-adapter
# STRIPE_SECRET_KEY=
NOTIFICATION_PROVIDER=log
# RESEND_API_KEY=
# MAIL_FROM=
OBJECT_STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_BUCKET=
